# Treetop Management Server — Environment Variables
# ─────────────────────────────────────────────────
# This file documents every variable the server reads.
# Copy it to .env and fill in real values — setup.bat does this automatically.
# NEVER commit .env to version control (it contains your JWT secret).

# ── Security ──────────────────────────────────────────────────────────────────
# Long random secret used to sign and verify JWT login tokens.
# Generated automatically by setup.bat.  DO NOT change this after users exist —
# changing it invalidates every active session and forces everyone to log in again.
JWT_SECRET=replace-with-a-long-random-string

# ── Network ───────────────────────────────────────────────────────────────────
# Port the API server listens on.  Default: 3001.
# Change if 3001 is already in use on your server machine.
PORT=3001

# ── Runtime mode ──────────────────────────────────────────────────────────────
# Use "production" for a deployed server.
# Use "development" for local development (enables nodemon, skips some guards).
# NOTE: setting this to "test" disables JWT auth — never use "test" in production.
NODE_ENV=production
